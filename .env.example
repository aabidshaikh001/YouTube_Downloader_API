# Copy to .env for local development. On Render, set these in the
# dashboard (Environment) instead — never commit a real .env.
# Render sets PORT itself; HOST is 0.0.0.0 by default.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Concurrency / limits (tuned for Render Free: 512 MB RAM, small
# ephemeral disk — lower MAX_DOWNLOAD_SIZE_MB if you hit disk limits).
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOAD_SIZE_MB=500
DOWNLOAD_TIMEOUT_MINUTES=20
JOB_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5
EXPIRED_GRACE_MINUTES=5

# Rate limits (per IP, per window).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
DOWNLOAD_RATE_LIMIT_MAX=20

# Comma-separated web origins allowed to call the API.
# chrome-extension:// origins are always allowed; localhost too.
CORS_ORIGINS=

# Paths to the binaries (defaults: yt-dlp, ffmpeg, ffprobe on PATH).
# On Render these are baked into the Docker image: yt-dlp at
# /usr/local/bin/yt-dlp (set in render.yaml) and ffmpeg/ffprobe from
# apt. The ffmpeg-static / ffprobe-static npm packages remain as a
# fallback for local non-Docker runs.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Only for networks that intercept TLS (corporate / sandbox proxies).
# Off by default. Do not enable on a public server unless you know
# the network does this.
YTDLP_NO_CHECK_CERTIFICATES=false

# Where finished files live until they expire (default: OS temp dir).
# DOWNLOADS_DIR=
